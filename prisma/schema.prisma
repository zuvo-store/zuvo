// ZUVO marketplace — Prisma schema (Postgres for hosted demo; SQLite file for local dev via schema.sqlite.prisma)
// Money is ALWAYS stored as integer cents. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ users/auth
model User {
  id            String    @id @default(cuid())
  name          String
  username      String    @unique
  email         String    @unique // always stored normalized (lowercase, trimmed)
  passwordHash  String
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN
  emailVerified DateTime?
  provider      String    @default("password") // password | google
  referralCode  String    @unique // personal code, e.g. "A1B2C3D4"
  referredById  String?
  referredBy    User?     @relation("ReferrerRelation", fields: [referredById], references: [id])
  referralsMade User[]    @relation("ReferrerRelation")

  sessions      Session[]
  emailTokens   EmailToken[]
  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  rewards       Reward[]
  referralsMadeByMe ReferralAttribution[] @relation("ReferrerAttributions")
  referralAttribution ReferralAttribution? @relation("ReferredAttribution")
  reviews       Review[]
  auditLogs     AuditLog[]
  vouchers      Promotion[] // user-specific vouchers assigned to this customer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zuzuPoints     Int              @default(0) // tap-to-earn balance
  zuzuPointsLogs ZuzuPointsLog[]
  lastZuzuTapAt  DateTime? // anti-abuse: DB-backed tap cooldown
}

model ZuzuPointsLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // +earned / -redeemed
  kind      String   // TAP | REDEEM | BONUS | ADJUST
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of the raw token; raw token only lives in the cookie
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  type      String    // VERIFY | RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ------------------------------------------------------------------ catalog
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?   // local /p/*.svg path
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  campaigns   Campaign[]
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  shortDesc          String?
  description        String?
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  brand              String?
  priceCents         Int
  originalPriceCents Int?
  costCents          Int      @default(0) // unit cost for profit reports
  currency           String   @default("USD")
  stock              Int      @default(0)
  sku                String?  @unique
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  images             Json     @default("[]") // string[] of local /p/*.svg paths
  attributes         Json?    // Record<string,string>
  featured           Boolean  @default(false)
  deal               Boolean  @default(false) // eligible for "Today's Deals"
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants    ProductVariant[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  orderItems  OrderItem[]
  stockAlerts StockAlert[]
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String  // e.g. "Color"
  value           String  // e.g. "Red"
  priceDeltaCents Int     @default(0)
  stock           Int     @default(0)
  sku             String? @unique
  sortOrder       Int     @default(0) // display order; lower = shown/selected first
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------ cart/wishlist
model CartItem {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  qty        Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@unique([guestToken, productId, variantId])
  @@index([guestToken])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String?
  country    String
  state      String
  city       String
  street     String
  apartment  String?
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------ orders/payments
// Order.status: DRAFT | PENDING_PAYMENT | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
// Payment.status: UNPAID | PENDING | SUCCEEDED | DECLINED | CANCELLED | FAILED | REFUNDED
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique // e.g. ZV-20261011-XXXX
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName      String?
  guestEmail     String?
  guestToken     String?
  status         String   @default("DRAFT")
  paymentStatus  String   @default("UNPAID")
  subtotalCents  Int      @default(0)
  discountCents  Int      @default(0)
  shippingCents  Int      @default(0)
  taxCents       Int      @default(0)
  totalCents     Int      @default(0)
  currency       String   @default("USD")
  contactJson    Json?    // {name,email,phone}
  addressJson    Json?    // shipping address snapshot
  deliveryMethod String?  // STANDARD | EXPRESS
  deliveryLabel  String?
  promoCode      String?
  campaignId     String? // auto-applied discount campaign
  campaignName   String? // campaign name snapshot for display
  zuzuPointsRedeemed Int @default(0) // points applied as discount
  zuzuDiscountCents  Int @default(0) // discount from points (1000 pts = $1)
  giftWrap         Boolean  @default(false) // gift wrapping requested
  giftWrapCents    Int      @default(0)     // gift wrap charge
  giftMessage      String?  // gift note from buyer
  cancelledAt      DateTime? // customer/admin cancellation time
  cancelReason     String?  // reason for cancellation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([guestToken])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name           String
  variantLabel   String?
  image          String?
  qty            Int
  unitPriceCents Int
  lineTotalCents Int
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String   @default("demo")
  scenario      String   // success | declined | pending | cancelled | error
  status        String   @default("PENDING")
  amountCents   Int
  currency      String   @default("USD")
  transactionRef String? @unique
  resultJson    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------------------ rewards
// Reward.status: AVAILABLE | PENDING | CLAIMED | EXPIRED | REJECTED | REVERSED
model RewardCampaign {
  id          String    @id @default(cuid())
  name        String
  amountCents Int
  currency    String    @default("USD")
  type        String    @default("SIGNUP") // SIGNUP | REFERRAL
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  label       String    @default("DEMO — NO CASH VALUE")
  terms       String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  rewards     Reward[]
}

model Reward {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   RewardCampaign @relation(fields: [campaignId], references: [id])
  status     String   @default("AVAILABLE")
  amountCents Int
  claimedAt  DateTime?
  expiresAt  DateTime?
  claimJson  Json?    // claim form snapshot
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  events     RewardEvent[]

  @@unique([userId, campaignId])
}

model RewardEvent {
  id        String   @id @default(cuid())
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus  String
  note      String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------ referrals
// ReferralAttribution.status: PENDING | ELIGIBLE | REJECTED
model ReferralAttribution {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("ReferrerAttributions", fields: [referrerId], references: [id])
  referredId String   @unique
  referred   User     @relation("ReferredAttribution", fields: [referredId], references: [id], onDelete: Cascade)
  code       String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model ReferralVisit {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())
  @@index([code])
}

// ------------------------------------------------------------------ promotions / misc
model Promotion {
  id             String    @id @default(cuid())
  code           String?   @unique // nullable for automatic promos
  title          String
  description    String?
  discountType   String    // PERCENT | FIXED
  discountValue  Int       // percent (1-90) or fixed cents
  minOrderCents  Int       @default(0)
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  // User-specific voucher: only this customer can use it (null = public code)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

// Scheduled sale events (e.g. "Eid Mega Sale") — auto-applied at checkout
// during their window, with a storefront banner.
model Campaign {
  id            String    @id @default(cuid())
  name          String // "Eid Mega Sale"
  bannerText    String? // "EID SALE — 25% OFF everything!"
  discountType  String // PERCENT | FIXED
  discountValue Int // percent (1-90) or fixed cents
  appliesTo     String    @default("ALL") // ALL | CATEGORY
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  minOrderCents Int       @default(0)
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metaJson  Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model StockAlert {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email     String
  userId    String?
  createdAt DateTime  @default(now())
  notifiedAt DateTime? // set when back-in-stock email sent

  @@unique([productId, email])
  @@index([productId])
}

model CartReminder {
  id         String   @id @default(cuid())
  email      String
  userId     String?
  guestToken String?
  itemCount  Int      @default(0)
  totalCents Int      @default(0)
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

model PageView {
  id          String   @id @default(cuid())
  path        String   // page path, e.g. /, /products, /p/some-slug
  visitorHash String   // sha256(ip + user-agent + day) — approx unique visitors, privacy-safe
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
